rules_version = '2';
// Only the signed-in admin can read or change the admin documents (the saved GitHub token).
// Keep the address in step with adminEmail in admin-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /admin/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'dustinwood01@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
